# Dependencies
node_modules/

# Build output
dist/
media/viewer.js
media/viewer.js.map
*.js.map

# Packaged extension
*.vsix

# Test runner cache
.vscode-test/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*.log
*.swp
*.swo

# Env / secrets
.env
.env.*

# Logs
npm-debug.log*
yarn-error.log

# TypeScript incremental build cache
*.tsbuildinfo

# VitePress docs build output
doc/.vitepress/dist
doc/.vitepress/cache

# TikZ icon build intermediates (icons/png/*.png and icons/svg-ui/*.svg
# previews are committed; only the LaTeX build scratch dirs are ignored)
icons/build/
icons/build-ui/
icons/build-ops/
icons/build-icon/

# Docs screenshot pipeline scratch (the generated PNGs under
# doc/public/screenshots/ ARE committed; only these intermediates are ignored)
scripts/screenshots/fixtures/
scripts/screenshots/.build/

# Integration-test bundle output (the downloaded VS Code itself lands in
# .vscode-test/, already ignored above).
test/integration/.build/
scripts/compat/last-run.json
scripts/probe/scratch/
scripts/probe/.build/
# `npm run scad:check -- <model.scad> --render` writes its PNGs here; the probe
# creates the directory on demand, so it must not be committable.
scad-render/

# Per-document sidecars the extension writes beside a CAD source, plus the
# one-deep <model>.bak save backup and the generated .geo script. These are
# per-user state, never fixtures — checked against the index: no tracked file
# matches any of them (the .csg/.stp/.stl fixtures are NOT affected).
*.edits.json
*.parts.json
*.annotations.json
*.planes.json
*.mesh.json
*.view.json
*.geo
*.bak
